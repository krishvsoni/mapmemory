NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://mapmemory:mapmemory@localhost:5432/mapmemory
# Optional: route read-heavy traversal/centrality/retrieval queries to a replica
DATABASE_READ_URL=
REDIS_URL=redis://localhost:6379

# openrouter | openai
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# Optional: a stronger model to escalate to when the cheap model extracts zero triplets
OPENROUTER_ESCALATION_CHAT_MODEL=
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_ESCALATION_CHAT_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

AUTH_JWT_SECRET=change-me
API_KEY_PEPPER=change-me
# Shared secret between this API and the dashboard's server (never the browser)
# for trusted server-to-server calls like developer-login auto-provisioning
INTERNAL_INTEGRATION_SECRET=change-me

WORKER_CONCURRENCY=4
REFLECTION_SWEEP_INTERVAL_MS=300000
# Caps concurrent LLM provider calls across ALL processes sharing this Redis
# instance (not per-process) — tune against your actual OpenRouter rate limit
LLM_GLOBAL_MAX_CONCURRENT=20

# Optional: billing is inactive until STRIPE_SECRET_KEY is set
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# Public URL of the dashboard, used to redirect back after Kinde login
DASHBOARD_URL=http://localhost:3000
# Optional: developer login is inactive until these are set. All Kinde
# secrets live here only — the frontend never receives them.
KINDE_ISSUER_URL=
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_CALLBACK_URL=http://localhost:4000/v1/auth/kinde/callback
